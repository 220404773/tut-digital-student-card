# TUT Digital Student Card - Configuration

DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
# On DigitalOcean App Platform, add your app's real hostname, e.g.:
# ALLOWED_HOSTS=localhost,127.0.0.1,tut-student-card-abc123.ondigitalocean.app
# Real client IP behind the host's load balancer (rate limits + activity log).
# Set whichever one your host actually provides - see tut_student_card/client_ip.py:
#   DigitalOcean App Platform: CLIENT_IP_HEADER=DO-Connecting-IP
#   One reverse proxy (e.g. Caddy) in front of the app: TRUSTED_PROXY_COUNT=1
CLIENT_IP_HEADER=
TRUSTED_PROXY_COUNT=0

# Days to keep page-visit rows and activity-log IP addresses (POPIA retention).
# Enforced by: python manage.py purge_old_activity  (run daily)
ACTIVITY_RETENTION_DAYS=90

# AI document extraction (Azure OpenAI, South Africa North). Leave blank to use
# rule-based extraction only. Values: Azure portal > your Azure OpenAI resource
# > Keys and Endpoint; deployment name from the Foundry portal > Deployments.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5-nano

# Fallback only when the Azure call fails. NVIDIA processes outside South
# Africa without a data processing agreement - leave blank to fall back to
# rule-based extraction instead.
NVIDIA_API_KEY=

# A card needs a profile photo, and a new photo after issue waits for staff
# approval. Set False only for an offline demo.
# REQUIRE_PHOTO_FOR_CARD=True

# Public address QR codes point to, e.g. https://your-app.ondigitalocean.app
# Blank = the address the page was opened on.
SITE_URL=

# Tesseract OCR binary path (only needed if not on PATH)
# Windows default install location:
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Database (SQLite for development)
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# For production with PostgreSQL:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=tut_student_card
# DB_USER=postgres
# DB_PASSWORD=your-password
# DB_HOST=localhost
# DB_PORT=5432

# Email (used for password reset and email confirmation).
# Defaults to printing to the console if unset - fine for local dev.
#
# Production uses Azure Communication Services' REST API (not SMTP) via a
# custom email backend - see tut_student_card/azure_email_backend.py 
# EMAIL_BACKEND=tut_student_card.azure_email_backend.AzureCommunicationEmailBackend
# AZURE_EMAIL_CONNECTION_STRING=endpoint=https://your-resource.region.communication.azure.com/;accesskey=your-key
# AZURE_EMAIL_SENDER_ADDRESS=DoNotReply@your-guid.azurecomm.net
# DEFAULT_FROM_EMAIL=DoNotReply@your-guid.azurecomm.net

# Media storage (profile pictures, QR codes) via DigitalOcean Spaces.
# Unset locally - files just save to the local media/ folder instead.
# AWS_STORAGE_BUCKET_NAME=tut-student-card
# AWS_ACCESS_KEY_ID=your-spaces-key
# AWS_SECRET_ACCESS_KEY=your-spaces-secret
# AWS_S3_ENDPOINT_URL=https://ams3.digitaloceanspaces.com
# AWS_S3_REGION_NAME=ams3

# Google Wallet - optional "Add to Google Wallet" button on the card page.
# Unset locally - the button just doesn't appear, nothing else is affected.
# GOOGLE_WALLET_CREDENTIALS_JSON is the *entire contents* of a Google Cloud
# service account JSON key file as one string (not a file path), from a
# service account added as Admin/Developer on your Wallet Issuer account.
# GOOGLE_WALLET_ISSUER_ID=your-issuer-id
# GOOGLE_WALLET_CREDENTIALS_JSON={"type":"service_account",...}
